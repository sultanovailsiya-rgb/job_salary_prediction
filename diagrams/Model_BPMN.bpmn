<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_model" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_model">
    <bpmn:participant id="Part_model" name="Оценка зарплаты вакансии с помощью ML-модели" processRef="Process_model" />
  </bpmn:collaboration>
  <bpmn:process id="Process_model" isExecutable="false">
    <bpmn:laneSet id="LaneSet_model">
      <bpmn:lane id="L_HR" name="HR-специалист">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ML" name="ML-модель (сервис предсказания)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_MON" name="Мониторинг (ML-инженер)">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Открыта новая вакансия" />
    <bpmn:userTask id="t1" name="Ввести параметры вакансии (9 признаков)" />
    <bpmn:serviceTask id="t2" name="Предсказать годовую зарплату (обученный pipeline)" />
    <bpmn:userTask id="t3" name="Проверить прогноз, сформировать вилку" />
    <bpmn:exclusiveGateway id="g1" name="Прогноз адекватен?" />
    <bpmn:userTask id="t4" name="Скорректировать вручную по рынку" />
    <bpmn:exclusiveGateway id="g1m" name="" />
    <bpmn:userTask id="t5" name="Включить зарплату в вакансию" />
    <bpmn:endEvent id="e1" name="Вакансия опубликована" />
    <bpmn:startEvent id="s2" name="Раз в месяц"><bpmn:timerEventDefinition /></bpmn:startEvent>
    <bpmn:serviceTask id="m1" name="Посчитать MAPE на фактических зарплатах" />
    <bpmn:exclusiveGateway id="g2" name="MAPE вырос более чем на 20 %?" />
    <bpmn:callActivity id="m2" name="Переобучить модель (см. схему переобучения)" />
    <bpmn:endEvent id="e2" name="Новая версия модели" />
    <bpmn:endEvent id="e3" name="Модель стабильна" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t2" targetRef="t3" name="прогноз, USD" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="g1" targetRef="g1m" name="да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="g1" targetRef="t4" name="нет" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t4" targetRef="g1m" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="g1m" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t5" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="s2" targetRef="m1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="m1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="g2" targetRef="m2" name="да" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="m2" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="g2" targetRef="e3" name="нет" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_model">
    <bpmndi:BPMNPlane id="Plane_model" bpmnElement="Collab_model">
      <bpmndi:BPMNShape id="Shape_Part" bpmnElement="Part_model" isHorizontal="true"><dc:Bounds x="20" y="20" width="1380" height="680" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_HR" bpmnElement="L_HR" isHorizontal="true"><dc:Bounds x="50" y="20" width="1350" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_ML" bpmnElement="L_ML" isHorizontal="true"><dc:Bounds x="50" y="280" width="1350" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_MON" bpmnElement="L_MON" isHorizontal="true"><dc:Bounds x="50" y="440" width="1350" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_s1" bpmnElement="s1"><dc:Bounds x="132" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t1" bpmnElement="t1"><dc:Bounds x="235" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t2" bpmnElement="t2"><dc:Bounds x="375" y="320" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t3" bpmnElement="t3"><dc:Bounds x="515" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_g1" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="685" y="75" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="650" y="31" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t4" bpmnElement="t4"><dc:Bounds x="795" y="160" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_g1m" bpmnElement="g1m" isMarkerVisible="true"><dc:Bounds x="965" y="75" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="930" y="31" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_t5" bpmnElement="t5"><dc:Bounds x="1075" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_e1" bpmnElement="e1"><dc:Bounds x="1252" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_s2" bpmnElement="s2"><dc:Bounds x="132" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_m1" bpmnElement="m1"><dc:Bounds x="235" y="480" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_g2" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="405" y="495" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="370" y="451" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_m2" bpmnElement="m2"><dc:Bounds x="515" y="480" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_e2" bpmnElement="e2"><dc:Bounds x="692" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_e3" bpmnElement="e3"><dc:Bounds x="552" y="602" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0"><di:waypoint x="168" y="100" /><di:waypoint x="235" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="345" y="100" /><di:waypoint x="360" y="100" /><di:waypoint x="360" y="360" /><di:waypoint x="375" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="485" y="360" /><di:waypoint x="500" y="360" /><di:waypoint x="500" y="100" /><di:waypoint x="515" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="625" y="100" /><di:waypoint x="685" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="735" y="100" /><di:waypoint x="965" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="710" y="125" /><di:waypoint x="710" y="200" /><di:waypoint x="795" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="905" y="200" /><di:waypoint x="990" y="200" /><di:waypoint x="990" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7"><di:waypoint x="1015" y="100" /><di:waypoint x="1075" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8"><di:waypoint x="1185" y="100" /><di:waypoint x="1252" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9"><di:waypoint x="168" y="520" /><di:waypoint x="235" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10"><di:waypoint x="345" y="520" /><di:waypoint x="405" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11"><di:waypoint x="455" y="520" /><di:waypoint x="515" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_12" bpmnElement="Flow_12"><di:waypoint x="625" y="520" /><di:waypoint x="692" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_13" bpmnElement="Flow_13"><di:waypoint x="430" y="545" /><di:waypoint x="430" y="620" /><di:waypoint x="552" y="620" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
