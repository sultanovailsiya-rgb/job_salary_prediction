      <bpmndi:BPMNShape id="Shape_d1" bpmnElement="d1"><dc:Bounds x="515" y="740" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ed1" bpmnElement="ed1"><dc:Bounds x="692" y="762" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_b2" bpmnElement="b2"><dc:Bounds x="515" y="220" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_b3" bpmnElement="b3"><dc:Bounds x="655" y="220" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gb2" bpmnElement="gb2" isMarkerVisible="true"><dc:Bounds x="825" y="235" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="790" y="191" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_eb1" bpmnElement="eb1"><dc:Bounds x="972" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_b4" bpmnElement="b4"><dc:Bounds x="935" y="220" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c1" bpmnElement="c1"><dc:Bounds x="1075" y="480" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gc1" bpmnElement="gc1" isMarkerVisible="true"><dc:Bounds x="1245" y="495" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1210" y="451" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ec1" bpmnElement="ec1"><dc:Bounds x="1392" y="602" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c2" bpmnElement="c2"><dc:Bounds x="1355" y="480" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c3" bpmnElement="c3"><dc:Bounds x="1495" y="480" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gc2" bpmnElement="gc2" isMarkerVisible="true"><dc:Bounds x="1665" y="495" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1630" y="451" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ec3" bpmnElement="ec3"><dc:Bounds x="1812" y="502" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_c4" bpmnElement="c4"><dc:Bounds x="1775" y="580" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ec2" bpmnElement="ec2"><dc:Bounds x="1952" y="602" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0"><di:waypoint x="168" y="100" /><di:waypoint x="201" y="100" /><di:waypoint x="201" y="260" /><di:waypoint x="235" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="345" y="260" /><di:waypoint x="405" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="455" y="260" /><di:waypoint x="515" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="430" y="285" /><di:waypoint x="430" y="780" /><di:waypoint x="515" y="780" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="625" y="780" /><di:waypoint x="692" y="780" /></bpmndi:BPMNEdge>
