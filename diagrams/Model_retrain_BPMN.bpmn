<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_retrain" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_retrain">
    <bpmn:participant id="Part_retrain" name="Автоматическое переобучение модели" processRef="Process_retrain" />
  </bpmn:collaboration>
  <bpmn:process id="Process_retrain" isExecutable="false">
    <bpmn:laneSet id="LaneSet_retrain">
      <bpmn:lane id="L_A" name="Планировщик и мониторинг">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_B" name="ML-пайплайн (Optuna, MLflow)">
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gb1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gb2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eb1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_C" name="CI/CD (GitHub Actions, Docker)">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ec1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ec3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ec2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_D" name="ML-инженер">
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ed1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Триггер: дрейф MAPE, новые данные или расписание" />
    <bpmn:serviceTask id="b1" name="Загрузить и подготовить новые данные" />
    <bpmn:exclusiveGateway id="gb1" name="Данные корректны?" />
    <bpmn:userTask id="d1" name="Разобрать проблему с данными" />
    <bpmn:endEvent id="ed1" name="Переобучение остановлено" />
    <bpmn:serviceTask id="b2" name="Обучить новую версию (Optuna, CV=3)" />
    <bpmn:serviceTask id="b3" name="Оценить качество, записать метрики в MLflow" />
    <bpmn:exclusiveGateway id="gb2" name="Не хуже текущей и выше порога?" />
    <bpmn:endEvent id="eb1" name="Версия отклонена, остаётся текущая" />
    <bpmn:serviceTask id="b4" name="Сохранить версию модели (pkl + метрики)" />
    <bpmn:serviceTask id="c1" name="Собрать Docker-образ, запустить pytest" />
    <bpmn:exclusiveGateway id="gc1" name="Тесты пройдены?" />
    <bpmn:endEvent id="ec1" name="Деплой отменён" />
    <bpmn:serviceTask id="c2" name="Задеплоить новую версию" />
    <bpmn:serviceTask id="c3" name="Проверить работу после деплоя" />
    <bpmn:exclusiveGateway id="gc2" name="Всё в порядке?" />
    <bpmn:endEvent id="ec3" name="Новая модель в эксплуатации" />
    <bpmn:serviceTask id="c4" name="Откатить на предыдущую версию" />
    <bpmn:endEvent id="ec2" name="Работает прежняя версия" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s1" targetRef="b1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="b1" targetRef="gb1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="gb1" targetRef="b2" name="да" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="gb1" targetRef="d1" name="нет" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="d1" targetRef="ed1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="b2" targetRef="b3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="b3" targetRef="gb2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="gb2" targetRef="b4" name="да" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="gb2" targetRef="eb1" name="нет" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="b4" targetRef="c1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="c1" targetRef="gc1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="gc1" targetRef="c2" name="да" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="gc1" targetRef="ec1" name="нет" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="c2" targetRef="c3" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="c3" targetRef="gc2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="gc2" targetRef="ec3" name="да" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="gc2" targetRef="c4" name="нет" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="c4" targetRef="ec2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_retrain">
    <bpmndi:BPMNPlane id="Plane_retrain" bpmnElement="Collab_retrain">
      <bpmndi:BPMNShape id="Shape_Part" bpmnElement="Part_retrain" isHorizontal="true"><dc:Bounds x="20" y="20" width="2080" height="840" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_A" bpmnElement="L_A" isHorizontal="true"><dc:Bounds x="50" y="20" width="2050" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_B" bpmnElement="L_B" isHorizontal="true"><dc:Bounds x="50" y="180" width="2050" height="260" /></bpmndi:BPMNShape>
