      <bpmndi:BPMNShape id="Shape_L_D" bpmnElement="L_D" isHorizontal="true"><dc:Bounds x="50" y="700" width="2050" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_s1" bpmnElement="s1"><dc:Bounds x="132" y="82" width="36" height="36" /></bpmndi:BPMNShape>
